# ==============================================================================
# TrackFlow Frontend Environment Configuration Example
# Copy this file to .env.development for local Vite development.
# In production, the client automatically defaults to relative path '/trackflow/api'.
# ==============================================================================

# Backend REST API Base URL (Used in local development mode)
VITE_API_URL=http://localhost:3000/api

# Optional: Base Path routing override (Defaults to '/trackflow/' in production build)
# VITE_BASE_PATH=/
