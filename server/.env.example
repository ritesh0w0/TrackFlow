# ==============================================================================
# TrackFlow Backend Environment Configuration Example
# Copy this file to .env and provide your local credentials.
# Never commit actual credentials or secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database Connection (PostgreSQL / Neon Serverless)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trackflow_dev?schema=public"

# Authentication & Security
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Cross-Origin Resource Sharing (CORS) & Client Routing
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cookie Isolation Configuration (Defaults applied automatically in production)
COOKIE_NAME=trackflow_token
COOKIE_PATH=/
